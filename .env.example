# 时区
TZ=Asia/Shanghai

# RustDesk API 预构建镜像（由 GitHub Actions 自动构建并推送到 GHCR；本地源码构建可配合 docker-compose.build.yml 使用）
# 国内加速示例：ghcr.nju.edu.cn/echolunet/rustdesk-api:latest 或 registry.cn-hangzhou.aliyuncs.com/<namespace>/rustdesk-api:latest
API_IMAGE=ghcr.io/echolunet/rustdesk-api:latest

# 官方 RustDesk Server 镜像（支持 Docker Hub 或 ghcr.io/rustdesk/rustdesk-server:latest）
# 国内加速示例：ghcr.nju.edu.cn/rustdesk/rustdesk-server:latest
RUSTDESK_SERVER_IMAGE=rustdesk/rustdesk-server:latest
# 强制密钥加密校验（-k _ 为官方服务端推荐安全参数；如需兼容未填 Key 的旧客户端可留空）
HBBS_EXTRA_ARGS=-k _
HBBR_EXTRA_ARGS=-k _

# 对外服务器地址（请替换为你的公网 IP 或域名）
RUSTDESK_ID_SERVER=your.domain.com:21116
RUSTDESK_RELAY_SERVER=your.domain.com:21117
RUSTDESK_API_SERVER=http://your.domain.com:21114

# API 服务端口
API_PORT=21114
GIN_MODE=release

# 数据库配置（默认 SQLite 持久化到 ./data/api/rustdesk-api.db）
DB_TYPE=sqlite
DB_DSN=
# MySQL 示例：
# DB_TYPE=mysql
# DB_DSN=user:pass@tcp(mysql:3306)/rustdesk?charset=utf8mb4&parseTime=True&loc=Local
# PostgreSQL 示例：
# DB_TYPE=postgres
# DB_DSN=host=postgres user=rustdesk password=secret dbname=rustdesk port=5432 sslmode=disable

# JWT 签名密钥（留空则在首次启动时自动生成并保存到 ./data/api/.jwt_secret）
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# 初始管理员账号（密码留空则在首次启动时随机生成并打印到容器日志）
ADMIN_INIT_USER=admin
ADMIN_INIT_PASSWORD=

# 权限与地址簿策略
ALLOW_ALL_DEVICES_FOR_USERS=false
MAX_PEER_ONE_AB=0

# 客户端默认策略（首次启动写入数据库并通过 /api/heartbeat 动态下发；也可在后台「客户端策略」实时修改）
CLIENT_STRATEGY_ENABLED=true
# 默认画质模式: custom(自定义帧率画质，使 FPS 生效) / balanced / best / low
CLIENT_DEFAULT_IMAGE_QUALITY=custom
# 默认帧率上限 (5–120 FPS)，常用 30 / 60 / 120
CLIENT_DEFAULT_FPS=60
# 自定义画质百分比 (10–100)
CLIENT_DEFAULT_QUALITY=75
# 首选编解码器: auto / vp9 / vp8 / h264 / h265 / av1
CLIENT_DEFAULT_CODEC=auto
# 客户端功能权限默认开关 (true / false)
CLIENT_ENABLE_HWCODEC=true
CLIENT_ENABLE_AUDIO=true
CLIENT_ENABLE_CLIPBOARD=true
CLIENT_ENABLE_FILE_TRANSFER=true
CLIENT_ENABLE_KEYBOARD=true
CLIENT_ENABLE_TUNNEL=true
CLIENT_ENABLE_REMOTE_RESTART=true
CLIENT_ENABLE_RECORD_SESSION=false
CLIENT_DIRECT_SERVER=false
# 验证与确认策略（留空则不覆盖客户端本地设置）
CLIENT_VERIFICATION_METHOD=
CLIENT_APPROVE_MODE=

# 国内服务器构建 Go 镜像可切换为 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct

# Watchtower 自动检查官方 hbbs/hbbr 更新的间隔秒数（默认 86400 = 24 小时）
WATCHTOWER_INTERVAL=86400
